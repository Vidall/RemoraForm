# -------------------------------------------------------------------
# @remora/backend — variáveis de ambiente
# Copie este arquivo para .env e ajuste os valores locais.
# -------------------------------------------------------------------

# Porta HTTP em que o NestJS escuta.
PORT=3333

# Conexão PostgreSQL usada pelo Prisma Client.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/remora_pages?schema=public"

# Origens permitidas pelo CORS (separadas por vírgula). Use "*" só em dev.
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
