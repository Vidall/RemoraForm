// -------------------------------------------------------------------
//  Prisma schema — @remora/backend
//  Modelo persistente do briefing coletado pelo app-forms.
//  Estrutura achatada por seção; produtos e provasSociais como JSON.
// -------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Briefing {
  id           String   @id @default(uuid())
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  status       String   @default("rascunho")

  // Seção 1 — Negócio
  negocioNome      String @map("negocio_nome")
  negocioSegmento  String @map("negocio_segmento")
  negocioDescricao String @map("negocio_descricao")
  negocioSlogan    String @map("negocio_slogan")

  // Seção 2 — Contato
  contatoWhatsapp  String  @map("contato_whatsapp")
  contatoInstagram String  @map("contato_instagram")
  contatoEmail     String? @map("contato_email")
  contatoEndereco  String? @map("contato_endereco")

  // Seção 3 — Identidade Visual
  corPrimaria   String @map("cor_primaria")
  corSecundaria String @map("cor_secundaria")
  tema          String
  estiloFonte   String @map("estilo_fonte")

  // Seção 4 — Herói
  heroTitulo    String @map("hero_titulo")
  heroSubtitulo String @map("hero_subtitulo")
  heroTextoCTA  String @map("hero_texto_cta")
  heroImagem    String @map("hero_imagem")

  // Seção 5 — Produtos (array JSON)
  produtos Json

  // Seção 6 — Provas Sociais (array JSON, opcional)
  provasSociais Json? @map("provas_sociais")

  // Seção 7 — Meta
  nomeCliente    String  @map("nome_cliente_interno")
  slugSubdominio String  @unique @map("slug_subdominio")
  observacoes    String?

  @@map("briefings")
  @@index([status])
  @@index([slugSubdominio])
}
